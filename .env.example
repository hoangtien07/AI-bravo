# Sao chép thành .env và điền key. KHÔNG commit .env (đã .gitignore).
# Provider mặc định = gemini (cloud). Đổi sang ollama để chạy self-host (không cần key).

LLM_PROVIDER=gemini          # gemini | openai | ollama
EMBED_PROVIDER=gemini        # gemini | openai | ollama

# Khoá API (chỉ cần cho provider cloud tương ứng)
GEMINI_API_KEY=
# OPENAI_API_KEY=

# (tuỳ chọn) ghi đè model / ngưỡng / bật-tắt tính năng
# LLM_MODEL=gemini-2.5-flash
# EMBED_MODEL=gemini-embedding-001
# MIN_SIM=0.55
# HYBRID_ENABLED=1
# RERANK_ENABLED=0
